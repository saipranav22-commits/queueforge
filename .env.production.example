# ==============================================================================
# QueueForge Production Environment Configuration Template
# Copy this file to .env.production and replace placeholders with secure values.
# NEVER commit .env.production with live credentials to version control.
# ==============================================================================

# Database Credentials
DB_NAME=queueforge
DB_USERNAME=queueforge_app
DB_PASSWORD=replace_with_a_secure_random_db_password_32_chars

# Application Security
ADMIN_API_KEY=replace_with_a_cryptographically_secure_admin_api_key_64_chars

# Host Port Bindings
FRONTEND_PORT=8088
# Leave monitoring ports bound to localhost for security, or remove if not exposing to host
PROMETHEUS_HOST_PORT=127.0.0.1:9091
GRAFANA_HOST_PORT=127.0.0.1:3001

# Monitoring Credentials
GRAFANA_ADMIN_USER=qf_admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_secure_grafana_password

# Worker Coordinator Tuning
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=250
WORKER_LEASE_DURATION_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_RECOVERY_POLL_INTERVAL_MS=5000

# Retry Engine Parameters
RETRY_INITIAL_DELAY_SECONDS=5
RETRY_MULTIPLIER=3.0
RETRY_MAX_DELAY_SECONDS=3600
RETRY_JITTER_FACTOR=0.20
