# ==============================================================================
# QueueForge V2 Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env on the target host:
#      cp .env.production.example .env
# 2. Restrict file permissions immediately:
#      chmod 600 .env
# 3. Generate high-entropy secrets using openssl:
#      openssl rand -hex 32
# 4. NEVER commit a populated .env file to version control.
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=prod

# Database Connection Settings
DB_NAME=queueforge
RECEIVER_DB_NAME=queueforge_payment_receiver
DB_USERNAME=queueforge_app

# Mandatory Cryptographic Secrets (MUST be configured; missing values abort startup)
# Generate with: openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_DB_PASSWORD_MIN_24_CHARS

# Administrative API Key (Used for CLI, Admin Login, & Session Unlock)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_HIGH_ENTROPY_HEX_KEY_MIN_64_CHARS

# Internal Payment Receiver Service Authentication Token
# Generate with: openssl rand -hex 32
RECEIVER_SERVICE_KEY=REPLACE_WITH_HIGH_ENTROPY_HEX_KEY_MIN_64_CHARS

# Loopback Port for Frontend Nginx (Upstream for Host Caddy/Nginx TLS Proxy)
# Bound strictly to 127.0.0.1:8088 on the host interface
FRONTEND_PORT=8088

# Public Demo Mode Toggle (false = strictly authenticated; true = anonymous summary telemetry)
QUEUEFORGE_PUBLIC_DEMO_MODE=false

# Production CORS Allowed Origins (Comma-separated HTTPS origins for public frontend)
QUEUEFORGE_CORS_ALLOWED_ORIGINS=https://queueforge.yourdomain.com

# Worker Fleet Configuration (Tuned for 4 GB RAM VPS)
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=250
WORKER_LEASE_DURATION_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_RECOVERY_POLL_INTERVAL_MS=5000
